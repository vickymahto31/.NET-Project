@model CreatePostViewModel
@{
    ViewData["Title"] = "Share an Anonymous Thought";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="mb-4">
        <a asp-controller="Posts" asp-action="Index" class="btn-outline-custom" style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.75rem; font-size: 0.85rem; margin-bottom: 0.75rem;">
            &larr; Back to Feed
        </a>
        <h1 style="font-size: 2.1rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.35rem;">
            Share Your Thoughts Anonymously
        </h1>
        <p style="font-size: 0.95rem; color: var(--text-secondary);">
            Whatever you are carrying—academic stress, placement doubts, personal dilemmas, or confessions—express it freely in a judgment-free space.
        </p>
    </div>

    <!-- Community Pledge Box -->
    <div class="guidelines-callout mb-4">
        <h4>🔒 Your Anonymity Is Guaranteed</h4>
        <ul>
            <li>No student names, roll numbers, or accounts are linked with this post.</li>
            <li>Please do not name or reveal personal details about other students or professors.</li>
            <li>Be honest and respectful—we are all peers facing similar struggles.</li>
        </ul>
    </div>

    <div class="form-card">
        <form asp-controller="Posts" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger-custom mb-3"></div>

            <!-- Post Title -->
            <div class="form-group">
                <label asp-for="Title" class="form-label-custom">Post Title *</label>
                <input asp-for="Title" class="form-control-custom" placeholder="e.g. Can't handle the pressure of Semester 5 lab exams" maxlength="200" required />
                <span asp-validation-for="Title" class="text-danger-custom"></span>
            </div>

            <div class="row">
                <!-- Category Dropdown -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CategoryId" class="form-label-custom">Select Category *</label>
                        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-control-custom" required></select>
                        <span asp-validation-for="CategoryId" class="text-danger-custom"></span>
                    </div>
                </div>

                <!-- Mood / Emotion Tag -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MoodTag" class="form-label-custom">Current Mood / Emotion *</label>
                        <select asp-for="MoodTag" class="form-control-custom" required>
                            <option value="Overwhelmed">😰 Overwhelmed</option>
                            <option value="Anxious">😟 Anxious</option>
                            <option value="Heartbroken">💔 Heartbroken</option>
                            <option value="Seeking Advice">💡 Seeking Advice</option>
                            <option value="Venting">😤 Venting</option>
                            <option value="Confused">🤔 Confused</option>
                            <option value="Humorous">😂 Humorous</option>
                            <option value="Grateful">🙏 Grateful</option>
                        </select>
                        <span asp-validation-for="MoodTag" class="text-danger-custom"></span>
                    </div>
                </div>
            </div>

            <!-- Pseudonym Alias Selector -->
            <div class="form-group">
                <label asp-for="AuthorAlias" class="form-label-custom">Anonymous Pseudonym</label>
                <div class="input-group">
                    <input asp-for="AuthorAlias" id="authorAlias" class="form-control-custom" placeholder="e.g. Quiet Owl, Curious Penguin" maxlength="50" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                    <button type="button" id="btnRandomAlias" class="btn-outline-custom" style="border-top-left-radius: 0; border-bottom-left-radius: 0; border-left: none;">
                        🎲 Randomize
                    </button>
                </div>
                <div class="form-hint">A randomized alias will be shown publicly to protect your identity.</div>
                <span asp-validation-for="AuthorAlias" class="text-danger-custom"></span>
            </div>

            <!-- Content Body -->
            <div class="form-group">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Content" class="form-label-custom" style="margin-bottom: 0;">What's on your mind? *</label>
                    <span class="form-hint"><span id="charCount">0</span> / 5000 chars</span>
                </div>
                <textarea asp-for="Content" id="postContent" rows="6" class="form-control-custom" placeholder="Write openly about your experiences, thoughts, questions, or feelings..." required minlength="10" maxlength="5000"></textarea>
                <span asp-validation-for="Content" class="text-danger-custom"></span>
            </div>

            <!-- Guidelines Agreement Checkbox -->
            <div class="form-group mb-4">
                <div class="form-check">
                    <input type="checkbox" asp-for="AcceptCommunityRules" class="form-check-input" id="acceptRules" required />
                    <label class="form-check-label" for="acceptRules" style="font-size: 0.88rem; color: var(--text-secondary);">
                        I agree to the <a asp-controller="Home" asp-action="Guidelines" target="_blank">Community Guidelines</a> and affirm that this post does not contain personal defamation, bullying, or sensitive personal data.
                    </label>
                </div>
                <span asp-validation-for="AcceptCommunityRules" class="text-danger-custom"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="Posts" asp-action="Index" class="btn-outline-custom">Cancel</a>
                <button type="submit" class="btn-primary-custom" style="padding: 0.65rem 1.75rem; font-size: 1rem;">
                    🚀 Publish Anonymously
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
