@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Moderator Dashboard";
}

<div class="container py-4">
    <div class="admin-header">
        <div>
            <h1 style="font-size: 2rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.25rem;">
                🛡️ Platform Moderation Console
            </h1>
            <p style="font-size: 0.95rem; color: var(--text-secondary); margin-bottom: 0;">
                Review student reports, moderate flagged confessions, and manage content safety.
            </p>
        </div>

        <div>
            <a asp-controller="Posts" asp-action="Index" class="btn-outline-custom">View Public Feed &rarr;</a>
        </div>
    </div>

    <!-- Statistics Overview Cards -->
    <div class="stats-grid">
        <div class="stat-box">
            <div class="stat-box-title">Total Posts</div>
            <div class="stat-box-number" style="color: #4f46e5;">@Model.TotalPosts</div>
        </div>

        <div class="stat-box">
            <div class="stat-box-title">Total Comments</div>
            <div class="stat-box-number" style="color: #059669;">@Model.TotalComments</div>
        </div>

        <div class="stat-box">
            <div class="stat-box-title">Pending Reports</div>
            <div class="stat-box-number" style="color: #e11d48;">@Model.PendingReports</div>
        </div>

        <div class="stat-box">
            <div class="stat-box-title">Hidden Posts</div>
            <div class="stat-box-number" style="color: #d97706;">@Model.HiddenPosts</div>
        </div>
    </div>

    <!-- Section 1: Reported Posts Table -->
    <section class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--text-primary); margin: 0;">
                🚩 Reported Content Queue (@Model.Reports.Count)
            </h2>
        </div>

        @if (!Model.Reports.Any())
        {
            <div class="form-card text-center py-4">
                <span style="font-size: 2rem;">🎉</span>
                <p style="color: var(--text-secondary); font-weight: 600; margin-top: 0.5rem; margin-bottom: 0;">
                    No reports submitted. The campus community is healthy and positive!
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Report ID</th>
                            <th>Target Post</th>
                            <th>Reason</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Moderator Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model.Reports)
                        {
                            <tr>
                                <td><strong>#@report.ReportId</strong></td>
                                <td>
                                    <div style="font-weight: 700; color: var(--text-primary); margin-bottom: 0.15rem;">
                                        <a asp-controller="Posts" asp-action="Details" asp-route-id="@report.PostId" target="_blank">
                                            @report.PostTitle
                                        </a>
                                    </div>
                                    <div style="font-size: 0.8rem; color: var(--text-muted);">@report.PostContentSnippet</div>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.8rem;">
                                        @report.Reason
                                    </span>
                                    @if (!string.IsNullOrEmpty(report.DetailedRemarks))
                                    {
                                        <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 0.25rem;">
                                            Note: @report.DetailedRemarks
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span style="font-size: 0.82rem; color: var(--text-muted);">
                                        @report.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                </td>
                                <td>
                                    @if (report.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (report.Status == "ActionTaken")
                                    {
                                        <span class="badge bg-danger">Action Taken</span>
                                    }
                                    else if (report.Status == "Dismissed")
                                    {
                                        <span class="badge bg-secondary">Dismissed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Reviewed</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (report.Status == "Pending")
                                        {
                                            <form asp-controller="Admin" asp-action="UpdateReportStatus" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reportId" value="@report.ReportId" />
                                                <input type="hidden" name="status" value="Reviewed" />
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Mark as reviewed">
                                                    ✓ Reviewed
                                                </button>
                                            </form>

                                            <form asp-controller="Admin" asp-action="UpdateReportStatus" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reportId" value="@report.ReportId" />
                                                <input type="hidden" name="status" value="Dismissed" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Dismiss false report">
                                                    ✕ Dismiss
                                                </button>
                                            </form>
                                        }

                                        <form asp-controller="Admin" asp-action="ToggleHidePost" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="postId" value="@report.PostId" />
                                            <input type="hidden" name="hide" value="true" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Hide post from public feed">
                                                Hide Post
                                            </button>
                                        </form>

                                        <form asp-controller="Admin" asp-action="DeletePost" method="post" onsubmit="return confirm('Delete post permanently?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="postId" value="@report.PostId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete post permanently">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- Section 2: All Community Posts Management -->
    <section>
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--text-primary); margin: 0;">
                All Campus Posts (@Model.AllPosts.Count)
            </h2>
        </div>

        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Mood</th>
                        <th>Support</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var post in Model.AllPosts)
                    {
                        <tr>
                            <td>#@post.PostId</td>
                            <td>
                                <strong>
                                    <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.PostId" target="_blank">
                                        @post.Title
                                    </a>
                                </strong>
                                <div style="font-size: 0.78rem; color: var(--text-muted);">
                                    By @post.AuthorAlias • @post.CreatedAt.ToString("MMM dd, yyyy")
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@post.CategoryName</span></td>
                            <td><span class="badge bg-light text-dark border">@post.MoodTag</span></td>
                            <td>❤️ @post.SupportCount</td>
                            <td>
                                @if (post.IsHidden)
                                {
                                    <span class="badge bg-danger">Hidden</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Visible</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <form asp-controller="Admin" asp-action="ToggleHidePost" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@post.PostId" />
                                        <input type="hidden" name="hide" value="@(post.IsHidden ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm @(post.IsHidden ? "btn-outline-success" : "btn-outline-warning")">
                                            @(post.IsHidden ? "Unhide" : "Hide")
                                        </button>
                                    </form>

                                    <form asp-controller="Admin" asp-action="DeletePost" method="post" onsubmit="return confirm('Are you sure you want to delete this post?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@post.PostId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
