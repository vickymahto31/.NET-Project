@model LoginViewModel
@{
    ViewData["Title"] = "Admin Moderation Sign In";
}

<div class="container py-5" style="max-width: 480px;">
    <div class="text-center mb-4">
        <div class="brand-logo-icon mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.5rem;">🛡️</div>
        <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.25rem;">Moderation Console</h1>
        <p style="font-size: 0.9rem; color: var(--text-secondary);">Sign in to review reported posts and manage platform safety.</p>
    </div>

    <!-- College Viva Demo Credentials Reminder -->
    <div class="alert alert-info py-2 px-3 mb-4" style="font-size: 0.85rem; border-radius: var(--radius-md);">
        <strong>Demo Credentials:</strong><br />
        Username: <code>admin</code><br />
        Password: <code>Admin@123</code>
    </div>

    <div class="form-card">
        <form asp-controller="Admin" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger-custom mb-3"></div>

            <div class="form-group">
                <label asp-for="Username" class="form-label-custom">Admin Username</label>
                <input asp-for="Username" class="form-control-custom" placeholder="admin" autofocus required />
                <span asp-validation-for="Username" class="text-danger-custom"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Password" class="form-label-custom">Admin Password</label>
                <input asp-for="Password" type="password" class="form-control-custom" placeholder="••••••••" required />
                <span asp-validation-for="Password" class="text-danger-custom"></span>
            </div>

            <button type="submit" class="btn-primary-custom w-100 justify-content-center py-2" style="font-size: 1rem;">
                Sign In to Console
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
