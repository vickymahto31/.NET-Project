@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var isAdminLoggedIn = HttpContextAccessor.HttpContext?.Session.GetString("AdminUsername") != null;
    var adminUser = HttpContextAccessor.HttpContext?.Session.GetString("AdminFullName") ?? "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WhisperSpace | Anonymous Student Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Navigation Bar -->
    <header class="app-navbar">
        <div class="nav-container">
            <a asp-controller="Home" asp-action="Index" class="brand-wrapper">
                <div class="brand-logo-icon">W</div>
                <div>
                    <span class="brand-name">WhisperSpace</span>
                    <span class="brand-badge">Anonymous</span>
                </div>
            </a>

            <nav>
                <ul class="nav-links">
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            Home
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Posts" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Posts" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            Explore Feed
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Guidelines" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Guidelines" ? "active" : "")">
                            Guidelines
                        </a>
                    </li>
                    @if (isAdminLoggedIn)
                    {
                        <li>
                            <a asp-controller="Admin" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" style="color: #4f46e5; font-weight: 700;">
                                Moderation Dashboard
                            </a>
                        </li>
                    }
                </ul>
            </nav>

            <div class="nav-actions">
                <a asp-controller="Posts" asp-action="Create" class="btn-primary-custom">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Share Thought
                </a>

                @if (isAdminLoggedIn)
                {
                    <a asp-controller="Admin" asp-action="Logout" class="btn-outline-custom" title="Logout @adminUser">
                        Logout
                    </a>
                }
                else
                {
                    <a asp-controller="Admin" asp-action="Login" class="btn-outline-custom">
                        Admin
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Global Toast Alerts from TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-toast success">
            <span><strong>Success:</strong> @TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close btn-close-sm" onclick="this.parentElement.style.display='none';"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-toast error">
            <span><strong>Notice:</strong> @TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close btn-close-sm" onclick="this.parentElement.style.display='none';"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert-toast info">
            <span>@TempData["InfoMessage"]</span>
            <button type="button" class="btn-close btn-close-sm" onclick="this.parentElement.style.display='none';"></button>
        </div>
    }

    <!-- Main Body Container -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- College Project Footer -->
    <footer class="app-footer">
        <div class="footer-container">
            <div>
                <p style="font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem;">WhisperSpace - Anonymous Student Platform</p>
                <p style="font-size: 0.82rem; color: var(--text-muted);">A safe, judgment-free space to share concerns, academic stress, and mental well-being anonymously.</p>
            </div>

            <div class="footer-badge-tech">
                <span>🎓 B.Tech Semester 5 Mini Project</span>
                <span>•</span>
                <span>ASP.NET Core MVC & ADO.NET (SQL Server)</span>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
