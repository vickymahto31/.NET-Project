@model List<Post>
@{
    ViewData["Title"] = "Safe & Anonymous Student Community";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    int totalPosts = ViewBag.TotalPosts ?? 0;
    int totalComments = ViewBag.TotalComments ?? 0;
    int totalSupports = ViewBag.TotalSupports ?? 0;
}

<div class="container py-4">
    <!-- Hero Banner -->
    <section class="hero-banner">
        <div class="hero-content">
            <div class="hero-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                100% Anonymous & Zero Judgement
            </div>
            <h1 class="hero-title">A safe haven for college students to speak their minds.</h1>
            <p class="hero-subtitle">
                Feeling burnt out by exams, anxious about placement interviews, or struggling with college life? Share your thoughts, vent freely, and receive genuine peer support without revealing your identity.
            </p>
            <div class="hero-buttons">
                <a asp-controller="Posts" asp-action="Create" class="btn-primary-custom" style="padding: 0.75rem 1.6rem; font-size: 1rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    Share Your Thought Anonymously
                </a>
                <a asp-controller="Posts" asp-action="Index" class="btn-outline-custom" style="background: rgba(255,255,255,0.1); color: #ffffff; border-color: rgba(255,255,255,0.3); padding: 0.75rem 1.4rem;">
                    Read Campus Feed &rarr;
                </a>
            </div>

            <div class="hero-stats-row">
                <div class="stat-item">
                    <h4>@totalPosts</h4>
                    <p>Anonymous Thoughts</p>
                </div>
                <div class="stat-item">
                    <h4>@totalSupports</h4>
                    <p>Peer Support Hearts</p>
                </div>
                <div class="stat-item">
                    <h4>@totalComments</h4>
                    <p>Encouraging Replies</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Explore by Categories Section -->
    <section class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.2rem;">Browse Discussion Categories</h2>
                <p style="font-size: 0.9rem; color: var(--text-secondary);">Filter confessions and questions by academic or personal topic.</p>
            </div>
            <a asp-controller="Posts" asp-action="Index" class="btn-outline-custom">View All Posts</a>
        </div>

        <div class="category-grid">
            @foreach (var cat in categories)
            {
                <a asp-controller="Posts" asp-action="Index" asp-route-categoryId="@cat.CategoryId" class="category-card">
                    <div>
                        <div class="category-header">
                            <div class="category-icon-box" style="background-color: @(cat.BadgeColor)15; color: @cat.BadgeColor;">
                                @if (cat.IconClass == "academic")
                                {
                                    <span>📚</span>
                                }
                                else if (cat.IconClass == "career")
                                {
                                    <span>💼</span>
                                }
                                else if (cat.IconClass == "mental")
                                {
                                    <span>🧠</span>
                                }
                                else if (cat.IconClass == "campus")
                                {
                                    <span>🏛️</span>
                                }
                                else if (cat.IconClass == "social")
                                {
                                    <span>🤝</span>
                                }
                                else
                                {
                                    <span>🌙</span>
                                }
                            </div>
                            <h3 class="category-title">@cat.Name</h3>
                        </div>
                        <p class="category-desc">@cat.Description</p>
                    </div>
                    <div class="category-footer">
                        <span>@cat.PostCount posts</span>
                        <span style="color: @cat.BadgeColor;">Explore &rarr;</span>
                    </div>
                </a>
            }
        </div>
    </section>

    <!-- Recent Anonymous Posts Snippet -->
    <section class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.2rem;">Recent Community Thoughts</h2>
                <p style="font-size: 0.9rem; color: var(--text-secondary);">Real voices from across campus. Share words of encouragement.</p>
            </div>
            <a asp-controller="Posts" asp-action="Index" class="btn-outline-custom">Open Full Feed &rarr;</a>
        </div>

        <div class="row">
            @foreach (var post in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="post-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="post-meta-top">
                                <div class="post-author-info">
                                    <div class="avatar-circle">🎭</div>
                                    <div>
                                        <div class="author-alias">@post.AuthorAlias</div>
                                        <div class="post-timestamp">@post.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    </div>
                                </div>
                                <div class="post-badges">
                                    <span class="badge-category" style="background-color: @(post.CategoryBadgeColor ?? "#2563eb")15; color: @(post.CategoryBadgeColor ?? "#2563eb");">
                                        @post.CategoryName
                                    </span>
                                    <span class="badge-mood">@post.MoodTag</span>
                                </div>
                            </div>

                            <h3 class="post-title">
                                <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.PostId">@post.Title</a>
                            </h3>

                            <p class="post-body-snippet">
                                @(post.Content.Length > 180 ? post.Content.Substring(0, 180) + "..." : post.Content)
                            </p>
                        </div>

                        <div class="post-card-actions mt-3">
                            <div class="post-action-group">
                                <form asp-controller="Posts" asp-action="Support" asp-route-id="@post.PostId" method="post" style="display:inline;">
                                    <button type="submit" class="action-btn support-btn" title="Send peer support">
                                        ❤️ <span>@post.SupportCount Support</span>
                                    </button>
                                </form>
                                <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.PostId" class="action-btn">
                                    💬 <span>@post.CommentCount Comments</span>
                                </a>
                            </div>

                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.PostId" style="font-size: 0.85rem; font-weight: 700;">
                                Read More &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- University Guidelines Callout Banner -->
    <section class="guidelines-callout d-flex flex-wrap align-items-center justify-content-between p-4" style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); border-left: 6px solid #4f46e5;">
        <div>
            <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.35rem;">How We Protect Your Anonymity</h3>
            <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 0;">We do not track IP addresses, real names, student roll numbers, or personal accounts. Everyone participates as an anonymous student peer.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="Home" asp-action="Guidelines" class="btn-outline-custom">Read Code of Conduct</a>
        </div>
    </section>
</div>
